# ─────────────────────────────────────────
# DISCORD - https://discord.com/developers/applications
# ─────────────────────────────────────────

# Your bot's token (Bot tab → Reset Token)
DISCORD_TOKEN=

# Your bot's Application ID (OAuth2 tab → Client ID, or General Information → Application ID)
CLIENT_ID=

# Authorized server for command registration and administrator-only test commands
TEST_GUILD_ID=
# Optional restriction to one voice channel inside that server
TEST_VOICE_CHANNEL_ID=

# Local defaults; real mode never silently falls back to mock data
RIOT_MODE=mock
TTS_PROVIDER=local
BOT_DATA_DIR=.data
# DATABASE_PATH overrides BOT_DATA_DIR if set
# DATABASE_PATH=/absolute/path/to/bot.sqlite3

# Reuse the installed Media environment and downloaded Qwen snapshot
LOCAL_TTS_PYTHON=/Users/zhihenggan/Documents/media/voice-engine/.venv/bin/python
LOCAL_TTS_MEDIA_ROOT=/Users/zhihenggan/Documents/media
LOCAL_TTS_TIMEOUT_MS=180000
LOCAL_TTS_QUEUE_LIMIT=8

# Profile icon CDN version; update with Riot Data Dragon releases
DDRAGON_VERSION=16.19.1

# ─────────────────────────────────────────
# RIOT GAMES - https://developer.riotgames.com
# ─────────────────────────────────────────

# Development API key (login → key shown on dashboard, expires every 24h)
RIOT_API_KEY=

# ─────────────────────────────────────────
# AZURE TEXT-TO-SPEECH - https://portal.azure.com
# ─────────────────────────────────────────

# Azure Speech resource key
AZURE_TTS_KEY=your_azure_speech_key_here

# Azure Speech resource region
AZURE_TTS_REGION=eastus
