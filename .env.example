# Discord: https://discord.com/developers/applications
# Bot token (Bot tab, Reset Token)
DISCORD_TOKEN=
# Application ID (General Information)
CLIENT_ID=
# Authorized server for command registration and administrator-only test commands
TEST_GUILD_ID=
# Optional: restrict test commands and mock announcements to one voice channel in that server
TEST_VOICE_CHANNEL_ID=
# Live verifier only: defaults to the server owner, who must be in that channel
# TEST_MEMBER_ID=

# Riot Games: https://developer.riotgames.com
# mock uses labeled fixtures; real needs RIOT_API_KEY and never falls back to mock data
RIOT_MODE=mock
# Development keys expire every 24 hours
RIOT_API_KEY=

# Optional overrides; the values shown are the defaults
# Holds the database and the daily logs in logs/
# BOT_DATA_DIR=.data
# DATABASE_PATH=<BOT_DATA_DIR>/bot.sqlite3
# DDRAGON_VERSION=16.19.1
# Local speech, see docs/local-voice.md; paths must be absolute
# LOCAL_TTS_MEDIA_ROOT=<home>/Documents/media
# LOCAL_TTS_PYTHON=<LOCAL_TTS_MEDIA_ROOT>/voice-engine/.venv/bin/python
# LOCAL_TTS_TIMEOUT_MS=180000
# LOCAL_TTS_QUEUE_LIMIT=8
