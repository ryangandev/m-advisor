{
  "name": "discord-bot-lol-stats-m-advisor",
  "version": "1.0.0",
  "description": "Discord Bot - M Advisor (策马军师)",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "node --import tsx --test tests/*.test.ts",
    "dev": "node --import tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "check": "npm run build && npm test",
    "register": "node dist/cli/register.js",
    "doctor": "node dist/cli/doctor.js",
    "verify:local": "node --import tsx scripts/verify-local.ts",
    "verify:discord": "node --import tsx scripts/verify-discord.ts",
    "benchmarks:sample": "node --import tsx scripts/sample-matches.ts",
    "benchmarks:build": "node --import tsx scripts/build-benchmarks.ts",
    "champions:update": "node --import tsx scripts/update-champion-names.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@snazzah/davey": "^0.1.12",
    "better-sqlite3": "^13.0.3",
    "discord.js": "^14.27.0",
    "dotenv": "^17.3.1",
    "ffmpeg-static": "^5.3.0",
    "opusscript": "^0.0.8"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true,
    "esbuild@0.28.2": true,
    "better-sqlite3@13.0.3": true,
    "fsevents@2.3.3": true
  }
}
